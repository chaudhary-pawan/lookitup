# ── Storage ───────────────────────────────────────────────────────────────────
# "local" for development (files saved to backend/uploads/)
# "cloudinary" for production
STORAGE_BACKEND=local

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for dev — zero config
DATABASE_URL=sqlite:///./lookitup.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/lookitup

# ── Celery / Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Face Engine ───────────────────────────────────────────────────────────────
# InsightFace model name. "buffalo_l" = best accuracy (downloads ~200MB on first run)
# "buffalo_s" = lighter/faster for testing
INSIGHTFACE_MODEL=buffalo_l

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_SIZE_MB=200

# ── Similarity Thresholds ─────────────────────────────────────────────────────
# Tune these after testing with real photos
# SIMILARITY_CONFIDENT=0.75
# SIMILARITY_POSSIBLE=0.55

# ── Cloudinary (only needed if STORAGE_BACKEND=cloudinary) ───────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
